{
  "name": "atena-crm",
  "version": "1.0.0",
  "description": "پورتال فروش آتنا زیست درمان",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "build": "vite build",
    "build:watch": "vite build --watch",
    "vue:dev": "vite",
    "setup": "node server/setup.js",
    "migrate": "node -e \"require('./server/db').initSchema().then(()=>process.exit(0)).catch(e=>{console.error(e);process.exit(1)})\"",
    "test": "node tests/unit.test.js && node tests/hr-leave.test.js && node tests/payroll-engine.test.js && node tests/behavioral.test.js && node tests/persistence.test.js && node tests/security.test.js",
    "test:qa": "node tests/qa-persistence-agent.js",
    "predeploy": "node scripts/predeploy-check.js",
    "rotate-secrets": "node scripts/rotate-secrets-checklist.js"
  },
  "dependencies": {
    "@stll/folio-core": "0.4.0",
    "@stll/folio-vue": "0.4.0",
    "bcryptjs": "^2.4.3",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.6",
    "express": "^4.18.2",
    "helmet": "^8.2.0",
    "jimp": "^1.6.1",
    "jsdom": "^29.1.1",
    "jsonwebtoken": "^9.0.2",
    "jsqr": "^1.4.0",
    "mssql": "^12.5.5",
    "multer": "^2.1.1",
    "pg": "^8.11.3",
    "prosemirror-history": "^1.5.0",
    "prosemirror-model": "^1.25.11",
    "prosemirror-state": "^1.4.4",
    "prosemirror-tables": "^1.8.5",
    "prosemirror-view": "^1.42.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.7",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "vue": "^3.5.38"
  },
  "overrides": {
    "@stll/folio-vue": {
      "@stll/folio-core": "0.4.0"
    }
  }
}
