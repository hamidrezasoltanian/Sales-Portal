PORT=3000

# PostgreSQL connection
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=atena_crm          # production
# PG_DATABASE=atena_crm_dev    # use in dev after: bash scripts/setup_dev_db.sh
PG_USER=atena_app        # use a dedicated DB user, NOT postgres superuser
PG_PASSWORD=yourpassword

# JWT signing secret — MUST be changed before deploying
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=change-this-to-a-random-secret-string

# Default passwords set during first-time DB seeding (only used if users table is empty)
ADMIN_PASSWORD=admin123
DEFAULT_USER_PASSWORD=Atena@1234

# Anthropic API key (optional — if set here, takes priority over DB setting and is never sent to clients)
# ANTHROPIC_API_KEY=sk-ant-...

# Faradis (MS-SQL accounting) — required for sync/integration features
# FARADIS_SERVER=your-sql-server-host
# FARADIS_PORT=50727
# FARADIS_DATABASE=faradissoftatenazist
# FARADIS_USER=ma
# FARADIS_PASSWORD=your-faradis-password
# FARADIS_INSTANCE=FARADISSOFT

# Pricing management access (margin/cost data) — use hash in production
# Generate hash: node -e "require('bcryptjs').hash('your-password',10).then(console.log)"
# PRICING_ACCESS_PASSWORD_HASH=$2a$10$...
# Or for dev only:
# PRICING_ACCESS_PASSWORD=your-pricing-password

# ── Backup alerts (Telegram) ───────────────────────────────────────────────
# Scheduled backups run via cron (scripts/setup-backup-cron.sh), NOT Node process.
# AUTO_BACKUP_SCHEDULER=false   # default — do not duplicate cron in Node
# TELEGRAM_BOT_TOKEN=...        # same bot as CRM Telegram (BotFather)
# BACKUP_ALERT_CHAT_ID=...      # your numeric chat id (message @userinfobot or /start bot then getUpdates)
# BACKUP_DIR=/home/hamidreza/db_backups
# BACKUP_RETENTION_DAYS=30
# BACKUP_MAX_AGE_SCHEDULED_H=8
# BACKUP_MAX_AGE_FULL_H=26
# BACKUP_MAX_AGE_APPDATA_M=30
